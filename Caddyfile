# ==========================================================
# Caddy: reverse proxy con TLS automático, cabeceras de
# seguridad y proxy de la API hacia el backend.
#
# El host se define con la variable de entorno PUBLIC_HOST.
#   - En local:  PUBLIC_HOST=localhost  -> Caddy usa TLS interno (autofirmado)
#   - En internet: PUBLIC_HOST=<ip-con-guiones>.nip.io -> Let's Encrypt automático
#
# Con nip.io, una IP como 203.0.113.10 se escribe 203-0-113-10.nip.io
# y resuelve a esa IP, permitiendo a Caddy emitir un certificado válido.
# ==========================================================

{
	# Email para Let's Encrypt (avisos de expiración). Cámbialo por el tuyo.
	email {$ACME_EMAIL:admin@example.com}
}

{$PUBLIC_HOST:localhost} {
	# ---- Cabeceras de seguridad ----
	header {
		# Fuerza HTTPS en navegadores durante 1 año.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Evita que la web se embeba en iframes (clickjacking).
		X-Frame-Options "DENY"
		# Evita el sniffing de tipo MIME.
		X-Content-Type-Options "nosniff"
		# Política de referrer razonable.
		Referrer-Policy "strict-origin-when-cross-origin"
		# CSP: permitimos solo recursos propios; imágenes data/blob para el QR.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		# No revelamos el servidor.
		-Server
	}

	# ---- Compresión ----
	encode gzip zstd

	# ---- API hacia el backend ----
	handle /api/* {
		reverse_proxy backend:3000 {
			# Pasamos la IP real al backend para su rate limiting.
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}

	# ---- Frontend (SPA) ----
	handle {
		root * /srv
		# Fallback a index.html para las rutas del router (/, /registro, /admin).
		try_files {path} /index.html
		file_server
	}

	# Límite de tamaño de request a nivel de proxy (defensa extra).
	request_body {
		max_size 128KB
	}
}
