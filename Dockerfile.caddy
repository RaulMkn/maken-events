# ---- Build del frontend ----
FROM node:26-alpine AS frontend-build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# ---- Caddy con los estáticos ----
FROM caddy:2-alpine AS runtime
# Estáticos del frontend servidos por Caddy.
COPY --from=frontend-build /app/dist /srv
# La configuración de Caddy se monta desde docker-compose (./Caddyfile).
