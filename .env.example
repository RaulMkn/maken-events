# ==========================================================
# Configuración de maken-events.
# Copia este fichero a .env y rellena los valores reales.
# NUNCA subas el .env real al repositorio.
# En producción se configuran como config vars de Heroku.
# ==========================================================

# ---- General ----
NODE_ENV=production
# Puerto del backend (Heroku lo inyecta automáticamente).
PORT=3000

# ---- Base de datos (PostgreSQL) ----
# En Heroku la inyecta el add-on Heroku Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fiesta
# SSL: true en Heroku, false en local.
DATABASE_SSL=false

# ---- Seguridad / sesiones ----
# Secreto para firmar las cookies de sesión admin (cadena larga y aleatoria).
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# ---- Admin ----
ADMIN_USER=admin
# Hash de la contraseña admin en formato "b64:..." (lo genera scripts/gen-admin.ts).
ADMIN_PASSWORD_HASH=
# Secreto TOTP base32 del admin (lo genera scripts/gen-admin.ts).
ADMIN_TOTP_SECRET=

# ---- Staff (equipo de puerta) ----
# Contraseña única y compartida para el lector de QR de la puerta (sin MFA).
STAFF_PASSWORD=

# ---- Email (Resend) ----
# API key de Resend (https://resend.com -> API Keys).
RESEND_API_KEY=
# Remitente: una dirección del dominio verificado en Resend.
EMAIL_FROM=entradas@maken-events.app
# Nombre del evento para asuntos y plantillas.
PARTY_NAME=Halloween 4.0

# ---- URL pública (para enlaces absolutos en emails, p. ej. el carrete) ----
APP_URL=https://maken-events.app

# ---- Carrete y galería de fotos (Appwrite Storage) ----
# Crea un proyecto, un bucket y una API key con scope files.write y files.read.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=
# Nº máximo de fotos por invitado (por defecto 10).
MAX_FOTOS_CARRETE=10

# ---- Extras de experiencia (todos opcionales) ----
# Playlist colaborativa de Spotify (enlace que se incluye en el email).
SPOTIFY_PLAYLIST_URL=
# Token para la galería compartida de fotos (va en el email). Si está vacío,
# la galería queda deshabilitada. Usa una cadena larga y aleatoria.
GALERIA_TOKEN=
