# ==========================================================
# Configuración de la web de la fiesta de Halloween
# Copia este fichero a .env y rellena los valores reales.
# NUNCA subas el .env real al repositorio.
# ==========================================================

# ---- General ----
NODE_ENV=production
# Puerto interno del backend (Caddy lo expone hacia fuera)
PORT=3000
# Dominio público (ej. 123-45-67-89.nip.io). Sin https://
PUBLIC_HOST=localhost

# ---- Base de datos ----
# Ruta al fichero SQLite (dentro del contenedor)
DATABASE_PATH=./data/fiesta.sqlite

# ---- Seguridad / sesiones ----
# Secreto para firmar cookies de sesión admin (usa una cadena larga y aleatoria)
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Secreto para firmar los tokens del QR de entrada
QR_TOKEN_SECRET=cambia-esto-por-otra-cadena-larga-y-aleatoria

# ---- Admin ----
# Usuario admin
ADMIN_USER=admin
# Hash de la contraseña admin (lo genera scripts/gen-admin.ts en formato "b64:...").
# Se codifica en base64 a propósito para que docker-compose no interprete los '$'.
ADMIN_PASSWORD_HASH=
# Secreto TOTP base32 del admin (se genera con el script scripts/gen-admin.ts)
ADMIN_TOTP_SECRET=

# ---- Staff (equipo de puerta) ----
# Contraseña única y compartida para acceder al lector de QR de la puerta.
# Login simple, sin MFA. Repártela solo entre quienes controlen la entrada.
STAFF_PASSWORD=

# ---- Email (Resend) ----
# API key de Resend (https://resend.com -> API Keys).
RESEND_API_KEY=
# Remitente: una dirección del dominio verificado en Resend.
EMAIL_FROM=entradas@maken-events.app
# Nombre de la fiesta para asuntos/plantillas
PARTY_NAME=Fiesta de Halloween
